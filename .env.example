# ---- Client (safe to expose: bundled into the browser app) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key
# Optional: a Google Cloud Map ID (needed for styled advanced markers in production)
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ---- Server-only secrets live in .env.server (never prefix with VITE_) ----
# SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_ACCESS_TOKEN=sbp_xxx
# VAPID_PRIVATE_KEY=xxx
